{
  "name": "mycopilot-next",
  "version": "1.0.0",
  "description": "A local-first AI desktop assistant powered by Electron, React, and Rust",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "author": "MyCopilot Contributors",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint --cache .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm test:officecli && pnpm test:office-renderer && pnpm test:mac-signing && pnpm test:dev-electron-icon && pnpm test:storage-reset-dev && pnpm test:artifact-runtime && pnpm test:web && pnpm test:rust",
    "test:officecli": "node --test scripts/prepare-officecli.test.mjs",
    "test:office-renderer": "node --test scripts/prepare-office-renderer.test.mjs scripts/verify-packaged-office-renderer.test.mjs scripts/prepare-word-pdf-renderer.test.mjs scripts/verify-packaged-word-pdf-renderer.test.mjs",
    "test:mac-signing": "node --test scripts/sign-macos.test.mjs scripts/verify-packaged-app.test.mjs scripts/verify-packaged-macos-signatures.test.mjs",
    "test:dev-electron-icon": "node --test scripts/prepare-dev-electron-icon.test.mjs",
    "test:storage-reset-dev": "node --test scripts/reset-dev-storage-command.test.mjs",
    "test:artifact-runtime": "node --test scripts/prepare-artifact-runtime.test.mjs scripts/pptxgenjs-notes-order.test.mjs scripts/presentation-sdk.test.mjs",
    "test:rust": "cargo test --workspace",
    "test:web": "pnpm prepare:office-renderer && vitest run --project unit --project browser && vitest run --project managed-playwright-e2e",
    "test:multi-agent-release": "node scripts/run-multi-agent-release-gate.mjs",
    "generate:playwright-conformance-report": "node scripts/playwright-conformance-report.mjs --write",
    "generate:agent-avatars": "node scripts/generate-agent-avatars.mjs",
    "verify:agent-avatars": "node scripts/generate-agent-avatars.mjs --check",
    "test:playwright-conformance-report": "node --test scripts/playwright-conformance-report.test.mjs",
    "test:playwright-fixed-catalog": "vitest run --project unit src/main/mcp/managedPlaywrightCatalog.test.ts",
    "test:playwright-round3-stress": "vitest run --project unit src/main/mcp/managedPlaywrightRound3Stress.test.ts",
    "test:playwright-packaged-startup": "node --test scripts/verify-packaged-playwright-startup.test.mjs",
    "verify:playwright-packaged-startup": "node scripts/verify-packaged-playwright-startup.mjs",
    "verify:playwright-round3-release": "pnpm test:playwright-fixed-catalog && pnpm test:playwright-round3-stress && pnpm test:playwright-packaged-startup && pnpm verify:playwright-packaged-startup && pnpm test:playwright-conformance-report",
    "test:web:install": "playwright install chromium",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "check": "pnpm format:check && pnpm check:docs && pnpm verify:agent-avatars && pnpm lint && pnpm typecheck && pnpm lint:rust && pnpm test",
    "start": "electron-vite preview",
    "prepare:officecli": "node scripts/prepare-officecli.mjs",
    "verify:officecli": "node scripts/prepare-officecli.mjs --verify",
    "prepare:office-renderer": "node scripts/prepare-office-renderer.mjs",
    "verify:office-renderer": "node scripts/prepare-office-renderer.mjs --verify",
    "prepare:word-pdf-renderer": "node scripts/prepare-word-pdf-renderer.mjs",
    "prepare:word-pdf-renderer-if-supported": "node scripts/prepare-word-pdf-renderer.mjs --if-supported",
    "verify:word-pdf-renderer": "node scripts/prepare-word-pdf-renderer.mjs --verify",
    "prepare:artifact-runtime": "node scripts/prepare-artifact-runtime.mjs",
    "verify:artifact-runtime": "node scripts/prepare-artifact-runtime.mjs --verify",
    "prepare:dev-electron-icon": "node scripts/prepare-dev-electron-icon.mjs",
    "storage:reset-dev": "electron scripts/reset-dev-storage.mjs",
    "dev": "pnpm prepare:officecli && pnpm prepare:office-renderer && pnpm prepare:word-pdf-renderer-if-supported && pnpm prepare:artifact-runtime && pnpm prepare:dev-electron-icon && electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "verify:core": "node scripts/verify-core-binary.mjs",
    "build:core": "cargo build --locked --release -p mycopilot-core-server --bin core-server && pnpm verify:core",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm prepare:officecli && pnpm prepare:office-renderer && pnpm prepare:word-pdf-renderer-if-supported && pnpm prepare:artifact-runtime && pnpm build && pnpm build:core && electron-builder --dir --config.mac.identity=null",
    "build:win": "node scripts/assert-package-platform.mjs win32 && pnpm prepare:officecli && pnpm prepare:office-renderer && pnpm prepare:word-pdf-renderer && pnpm prepare:artifact-runtime && pnpm build && pnpm build:core && electron-builder --win",
    "build:mac": "node scripts/assert-package-platform.mjs darwin && pnpm prepare:officecli && pnpm prepare:office-renderer && pnpm prepare:word-pdf-renderer && pnpm prepare:artifact-runtime && pnpm build && pnpm build:core && electron-builder --mac --config.forceCodeSigning=true",
    "build:linux": "node scripts/assert-package-platform.mjs linux && pnpm prepare:officecli && pnpm prepare:office-renderer && pnpm prepare:word-pdf-renderer && pnpm prepare:artifact-runtime && pnpm build && pnpm build:core && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/mcp": "0.0.79",
    "node-pty": "^1.1.0",
    "playwright": "1.63.0-alpha-2026-08-05"
  },
  "devDependencies": {
    "@dicebear/core": "10.5.0",
    "@dicebear/styles": "10.5.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/osx-sign": "1.3.3",
    "@mycopilot/host-api": "workspace:*",
    "@mycopilot/office-playwright-runtime": "npm:playwright@1.61.1",
    "@mycopilot/protocol": "workspace:*",
    "@pierre/trees": "1.0.0-beta.5",
    "@shikijs/langs": "4.3.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "material-icon-theme": "^5.36.1",
    "mdast-util-from-markdown": "^2.0.3",
    "pdfjs-dist": "5.4.296",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "4.3.1",
    "tar": "7.5.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  }
}
