{
  "name": "mycopilot-next",
  "version": "1.0.0",
  "description": "A local-first AI desktop assistant powered by Electron, React, and Rust",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "author": "MyCopilot Contributors",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint --cache .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test": "cargo test --workspace",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm lint:rust && pnpm test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "verify:core": "node scripts/verify-core-binary.mjs",
    "build:core": "cargo build --locked --release -p mycopilot-core-server --bin core-server && pnpm verify:core",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && pnpm build:core && electron-builder --dir",
    "build:win": "node scripts/assert-package-platform.mjs win32 && pnpm build && pnpm build:core && electron-builder --win",
    "build:mac": "node scripts/assert-package-platform.mjs darwin && pnpm build && pnpm build:core && electron-builder --mac",
    "build:linux": "node scripts/assert-package-platform.mjs linux && pnpm build && pnpm build:core && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@mycopilot/host-api": "workspace:*",
    "@mycopilot/protocol": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "mdast-util-from-markdown": "^2.0.3",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
