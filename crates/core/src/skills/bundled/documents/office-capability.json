{
  "contractVersion": 10,
  "engine": "officecli",
  "tool": "office_document",
  "extensions": [".docx"],
  "modes": {
    "native": {
      "tool": "office_document",
      "bestFor": "read_inspect_validate_render",
      "requestStyle": "flat_semantic_v1",
      "reasonField": "reason",
      "reasonRequired": true,
      "providerArguments": "host_generated",
      "writeOperationsModelVisible": false,
      "operations": ["status", "inspect", "validate", "render"],
      "unsupportedRecovery": "useManagedScript",
      "renderOutput": {
        "resultField": "outputs",
        "role": "render",
        "kind": "image",
        "pathField": "readPath",
        "consumerTool": "read_image",
        "consumerField": "path",
        "readabilityField": "readableByAgent",
        "sizeField": "sizeBytes",
        "selectionField": "pageSelection",
        "selectionSemantics": "requested_not_verified_coverage",
        "pathInference": "forbidden"
      }
    },
    "script": {
      "builderTemplate": "templates/builder.py",
      "editorTemplate": "templates/editor.py",
      "editingReference": "references/editing-existing.md",
      "routes": {
        "create": "builder",
        "editExisting": "editor",
        "inspectValidateRender": "native"
      },
      "editTools": ["apply_patch", "write_file"],
      "executionTool": "run_command",
      "runtimeProfile": "documents",
      "runtimeProfileBinding": "host_from_materialized_script_receipt",
      "outputArgument": "--output",
      "lifecycle": {
        "prepareDirectoryBeforeMaterialize": true,
        "reuseSingleScript": true,
        "cleanupTaskOwnedFiles": true,
        "removeDirectoryOnlyIfTaskCreatedAndEmpty": true,
        "recursiveDelete": "forbidden"
      },
      "syntaxPreflight": {
        "binding": "hostAutomaticBeforeExecution",
        "language": "python",
        "modelCommand": "forbidden",
        "invalidatesOnScriptChange": true,
        "executionOnFailure": "forbidden"
      },
      "editor": {
        "sourceArgument": "--source",
        "sourceArgumentCardinality": 1,
        "outputArgument": "--output",
        "outputArgumentCardinality": 1,
        "sourceBinding": "inputs.mountPath",
        "sourceRequired": true,
        "inspectBeforeEdit": true,
        "defaultPublishMode": "saveAs",
        "supportedPublishModes": ["saveAs"],
        "inPlace": false,
        "boundedEditRegion": {
          "begin": "# BEGIN EDIT REGION",
          "end": "# END EDIT REGION"
        },
        "modelCode": {
          "language": "python",
          "execution": "normalPython",
          "astOrJsonDsl": false,
          "supports": [
            "pinnedImports",
            "functions",
            "loops",
            "conditions",
            "comprehensions",
            "dataTransformations",
            "pythonDocxObjectModel"
          ],
          "dependencyPolicy": "profilePinned",
          "permissionBoundary": "managedCommandApproval"
        },
        "fixedWrapper": {
          "sourceResolution": "MYCOPILOT_INPUT_ROOT",
          "auxiliaryInputResolution": "mounted_input",
          "temporarySave": true,
          "candidateReopen": true,
          "modelPatchScope": "boundedEditRegionOnly"
        },
        "transaction": {
          "script": "frozenBeforeLaunch",
          "source": "frozenReadOnlyMount",
          "candidate": "hostPrivate",
          "packageValidation": "requiredBeforePublish",
          "publication": "atomic",
          "failureBeforePublish": "hostCandidateNotPublishedToDeclaredDestination",
          "pythonSideEffectScope": "outsideOfficePublicationNotTransactional"
        },
        "fidelity": {
          "roundTripIsProof": false,
          "unsupportedMustFailClosed": true,
          "rawOoxmlFallback": "onlyWithExplicitRequestAndFeatureSpecificVerifier"
        }
      },
      "entrypoints": [
        {
          "command": "python",
          "extension": ".py",
          "runtimeVersion": "3.12.13",
          "dependencies": [{ "name": "python-docx", "version": "1.2.0" }]
        }
      ],
      "resolution": {
        "authority": "host",
        "runtimeKindFrom": "command",
        "dependencyPolicy": "profilePinned"
      },
      "inputs": {
        "field": "inputs",
        "mountPathField": "mountPath",
        "pathField": "path",
        "rootEnvironment": "MYCOPILOT_INPUT_ROOT",
        "pathKinds": [
          "workspace",
          "absolute_or_system",
          "attachment_read_path",
          "generated_artifact_uri",
          "revision_bound_skill_uri"
        ]
      },
      "observation": {
        "requiredFromModel": false,
        "binding": "host_from_materialization_and_output_argument",
        "kind": "office",
        "additionalRootsField": "observe.additionalRoots",
        "resultField": "artifactObservation"
      }
    }
  },
  "validation": {
    "inspectFinal": true,
    "pageCountSource": "notAvailableInCurrentSemanticSurface",
    "authoritativePageCountAvailable": false,
    "packageValidation": "nativeValidate",
    "visual": {
      "coverage": "overviewPlusIndividuallyVerifiedKnownPages",
      "renderModes": ["wholeDocumentOverview", "oneKnownPagePerRequest"],
      "consumeEveryReturnedReadPath": true,
      "requiredLedger": "numberedPagesActuallyRead",
      "contactSheetSemantics": "overviewOnlyNotPageCountOrCoverageEvidence",
      "pageRangeRequests": "notSupported",
      "exhaustiveCoverageClaim": "forbiddenWithoutTrustedFinalPageCount"
    },
    "structuralChecks": {
      "requiredFor": [
        "comments",
        "trackedChanges",
        "fields",
        "contentControls",
        "advancedOoxml"
      ],
      "renderingSufficient": false,
      "unavailableHandling": "discloseUnverifiedOrFailClosedWhenRequired"
    },
    "evidenceInvalidation": "anyFinalDocumentEdit"
  }
}
