{
  "contractVersion": 14,
  "engine": "officecli",
  "tool": "office_document",
  "extensions": [".docx"],
  "modes": {
    "native": {
      "tool": "office_document",
      "bestFor": "read_inspect_render",
      "requestStyle": "flat_semantic_v1",
      "reasonField": "reason",
      "reasonRequired": true,
      "providerArguments": "host_generated",
      "writeOperationsModelVisible": false,
      "operations": ["inspect", "render"],
      "unsupportedRecovery": "useManagedScript",
      "renderOutput": {
        "resultField": "outputs",
        "role": "render",
        "kind": "image",
        "pathField": "readPath",
        "consumerTool": "read_image",
        "consumerField": "path",
        "readabilityField": "readableByAgent",
        "sizeField": "sizeBytes",
        "selectionField": "pageSelection",
        "selectionSemantics": "requested_not_verified_coverage",
        "pathInference": "forbidden",
        "finalVisualQaEvidence": "forbidden"
      },
      "pdfQaOutput": {
        "operation": "render",
        "requestRequiredFields": ["operation", "filePath", "outputPath", "outputFormat", "reason"],
        "outputFormat": "pdf",
        "outputPathExtension": ".pdf",
        "outputPathKind": "workspaceRelative",
        "outputPathScope": "existingTaskScriptOrTemporaryDirectory",
        "topLevelOutputsDirectory": "forbidden",
        "oneCallPerFinalDocumentRevision": true,
        "resultField": "outputs",
        "pathField": "readPath",
        "pageCountField": "outputs[].pageCount",
        "sourceRevisionField": "outputs[].sourceSha256",
        "rendererRevisionField": "outputs[].rendererRevision",
        "requiredResultFields": ["outputs"],
        "requiredPdfOutputFields": ["readPath", "pageCount", "sourceSha256", "rendererRevision"],
        "pathInference": "forbidden",
        "handoff": {
          "skill": "pdf",
          "instructionOnly": true,
          "runtimeEnforced": false,
          "source": "outputs[].readPath",
          "sourcePathKind": "workspaceRelative",
          "sourcePathMode": "exactDirect",
          "runCommandInputsRequired": false,
          "myCopilotInputRootRewrite": "forbidden"
        }
      }
    },
    "script": {
      "builderTemplate": "templates/builder.py",
      "editorTemplate": "templates/editor.py",
      "editingReference": "references/editing-existing.md",
      "routes": {
        "create": "builder",
        "editExisting": "editor",
        "inspectRender": "native"
      },
      "editTools": ["apply_patch"],
      "executionTool": "run_command",
      "runtimeProfile": "documents",
      "runtimeProfileBinding": "host_from_materialized_script_receipt",
      "outputArgument": "--output",
      "lifecycle": {
        "prepareDirectoryBeforeMaterialize": true,
        "defaultOutputScope": "workspaceRoot",
        "nestedOutputParentMustExistBeforeRun": true,
        "reuseSingleScript": true,
        "cleanupTaskOwnedFiles": true,
        "removeDirectoryOnlyIfTaskCreatedAndEmpty": true,
        "recursiveDelete": "forbidden"
      },
      "syntaxPreflight": {
        "binding": "hostAutomaticBeforeExecution",
        "language": "python",
        "modelCommand": "forbidden",
        "invalidatesOnScriptChange": true,
        "executionOnFailure": "forbidden"
      },
      "editor": {
        "sourceArgument": "--source",
        "sourceArgumentCardinality": 1,
        "outputArgument": "--output",
        "outputArgumentCardinality": 1,
        "sourceBinding": "inputs.mountPath",
        "sourceRequired": true,
        "inspectBeforeEdit": true,
        "defaultPublishMode": "saveAs",
        "supportedPublishModes": ["saveAs"],
        "inPlace": false,
        "boundedEditRegion": {
          "begin": "# BEGIN EDIT REGION",
          "end": "# END EDIT REGION"
        },
        "modelCode": {
          "language": "python",
          "execution": "normalPython",
          "astOrJsonDsl": false,
          "supports": [
            "pinnedImports",
            "functions",
            "loops",
            "conditions",
            "comprehensions",
            "dataTransformations",
            "pythonDocxObjectModel"
          ],
          "dependencyPolicy": "profilePinned",
          "permissionBoundary": "managedCommandApproval"
        },
        "fixedWrapper": {
          "sourceResolution": "MYCOPILOT_INPUT_ROOT",
          "auxiliaryInputResolution": "mounted_input",
          "temporarySave": false,
          "candidateReopen": false,
          "candidateValidationOwner": "hostPinnedOfficeCliSchemaGate",
          "scriptOutputWrite": "directToHostPrivateCandidate",
          "modelPatchScope": "boundedEditRegionOnly"
        },
        "transaction": {
          "script": "frozenBeforeLaunch",
          "source": "frozenReadOnlyMount",
          "candidate": "hostPrivate",
          "packageValidation": {
            "owner": "host",
            "phase": "prepublish",
            "engine": "pinnedOfficeCli",
            "mode": "strictSchema",
            "required": true,
            "modelNativeValidate": "forbidden",
            "failurePublication": "forbidden",
            "failureDiagnostics": {
              "required": true,
              "providerStableFields": [
                "type",
                "description",
                "path",
                "part",
                "code",
                "error",
                "message"
              ],
              "hostFields": ["errorCode", "error"],
              "bounded": true
            }
          },
          "publication": "atomic",
          "failureBeforePublish": "hostCandidateNotPublishedToDeclaredDestination",
          "pythonSideEffectScope": "outsideOfficePublicationNotTransactional"
        },
        "fidelity": {
          "roundTripIsProof": false,
          "unsupportedMustFailClosed": true,
          "rawOoxmlFallback": "onlyWithExplicitRequestAndFeatureSpecificVerifier"
        }
      },
      "exceptionalFallback": {
        "trigger": "unexpectedBuilderOrEditorLimitation",
        "scope": ["create", "editExisting"],
        "script": "taskScopedSelfAuthoredPython",
        "executionTool": "run_command",
        "runtimeProfileRequired": "documents",
        "fullPython": true,
        "inputBinding": "run_command.inputs",
        "editPublishMode": "saveAsDistinctDocx",
        "permissionBoundary": "unchanged",
        "templateMaterializationReceipt": false,
        "hostPrivateCandidateTransaction": false,
        "scriptPublication": "temporarySaveReopenSanityCheckThenOsReplace",
        "artifactObservationRequired": true,
        "finalInspectionRequired": true,
        "pdfVisualQaRequired": true,
        "cleanupRequired": true,
        "visualQaConversion": "managedOnly",
        "forbiddenVisualQaConverters": [
          "reportlabReconstruction",
          "pageImageStitching",
          "modelAuthoredDocxToPdf"
        ]
      },
      "entrypoints": [
        {
          "command": "python",
          "extension": ".py",
          "runtimeVersion": "3.12.13",
          "dependencies": [{ "name": "python-docx", "version": "1.2.0" }]
        }
      ],
      "resolution": {
        "authority": "host",
        "runtimeKindFrom": "command",
        "dependencyPolicy": "profilePinned"
      },
      "inputs": {
        "field": "inputs",
        "mountPathField": "mountPath",
        "pathField": "path",
        "rootEnvironment": "MYCOPILOT_INPUT_ROOT",
        "pathKinds": [
          "workspace",
          "absolute_or_system",
          "attachment_read_path",
          "generated_artifact_uri",
          "revision_bound_skill_uri"
        ]
      },
      "observation": {
        "requiredFromModel": false,
        "binding": "host_from_materialization_and_output_argument",
        "kind": "office",
        "additionalRootsField": "observe.additionalRoots",
        "resultField": "artifactObservation"
      }
    }
  },
  "validation": {
    "inspectFinal": true,
    "pageCountSource": "pdfSkillPdfinfoOnExactReturnedPdf",
    "authoritativePageCountAvailable": true,
    "conversionPageCountField": "outputs[].pageCount",
    "conversionAndPdfinfoMustAgree": true,
    "packageValidation": "hostPrepublishPinnedOfficeCliSchemaGate",
    "modelNativeValidate": "forbidden",
    "visual": {
      "coverage": "everyPdfPageOneThroughAuthoritativeN",
      "renderModes": ["managedDocxToPdfOnce", "pdfSkillPdftoppmAllPages"],
      "consumeEveryReturnedReadPath": true,
      "requiredLedger": "oneVerdictPerPageOneThroughN",
      "contactSheetSemantics": "neverPageCountOrCompleteCoverageEvidence",
      "pageRangeRequests": "pdfSkillOneThroughN",
      "exhaustiveCoverageClaim": "allowedOnlyAfterEveryPageOneThroughNIsRead",
      "handoffSkill": "pdf",
      "handoffRuntimeEnforced": false,
      "authoritativePageCountCommand": "pdfinfo",
      "pageRasterizer": "pdftoppm",
      "maxPagesPerRasterBatch": 32,
      "fieldChecks": {
        "PAGE": "visibleAndCorrectForDocumentNumberingRules",
        "NUMPAGES": "visibleAndEqualsAuthoritativeN"
      },
      "modelAuthoredDocxToPdf": "forbidden"
    },
    "structuralChecks": {
      "requiredFor": ["comments", "trackedChanges", "fields", "contentControls", "advancedOoxml"],
      "renderingSufficient": false,
      "unavailableHandling": "discloseUnverifiedOrFailClosedWhenRequired"
    },
    "evidenceInvalidation": {
      "trigger": "anyFinalDocumentEdit",
      "invalidates": ["temporaryPdf", "pageCount", "pageImages", "pageLedger"]
    },
    "temporaryArtifactCleanup": {
      "afterCompleteLedger": true,
      "deleteExact": ["builderOrEditorOrFallbackScript", "qaPdf", "workspacePageImages"],
      "managedPdfPageImages": "hostRunWorkspaceCleanupAfterRead",
      "preserve": ["finalDocx", "preExistingFiles"],
      "qaPdfIsFinalArtifact": false,
      "recursiveDelete": "forbidden"
    }
  }
}
