{
  "contractVersion": 4,
  "engine": "officecli",
  "tool": "office_document",
  "extensions": [".docx"],
  "modes": {
    "native": {
      "tool": "office_document",
      "bestFor": "targeted_structured_operations",
      "requestStyle": "typed_request_envelope",
      "envelopeField": "request",
      "reasonField": "reason",
      "filePathField": "filePath",
      "providerArguments": "host_generated"
    },
    "script": {
      "editTools": ["apply_patch", "write_file"],
      "executionTool": "run_command",
      "runtimeProfile": "documents",
      "runtimeProfileField": "runtimeProfile",
      "entrypoints": [
        { "command": "python", "extension": ".py" },
        { "command": "node", "extension": ".mjs" }
      ],
      "resolution": {
        "authority": "host",
        "runtimeKindFrom": "command",
        "dependencyPolicy": "profilePinned"
      },
      "observation": {
        "kind": "office",
        "expectedOutputsField": "observe.expectedOutputs",
        "additionalRootsField": "observe.additionalRoots",
        "resultField": "artifactObservation"
      }
    }
  }
}
