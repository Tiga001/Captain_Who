{
  "contractVersion": 11,
  "engine": "officecli",
  "tool": "office_presentation",
  "extensions": [".pptx"],
  "modes": {
    "native": {
      "tool": "office_presentation",
      "bestFor": "authoritative_read_validate_render",
      "requestStyle": "flat_semantic_v1",
      "reasonField": "reason",
      "reasonRequired": true,
      "providerArguments": "host_generated",
      "operations": ["status", "inspect", "validate", "render"],
      "writeOperationsModelVisible": false,
      "modelVisibleWrites": "forbidden",
      "writeRoute": "managedScripts",
      "unsupportedRecovery": "useManagedScript",
      "renderOutput": {
        "resultField": "outputs",
        "role": "render",
        "kind": "image",
        "pathField": "readPath",
        "consumerTool": "read_image",
        "consumerField": "path",
        "readabilityField": "readableByAgent",
        "sizeField": "sizeBytes",
        "selectionField": "pageSelection",
        "selectionSemantics": "requested_not_verified_coverage",
        "layoutCoverageField": "layoutCoverage",
        "layoutCoverageSemantics": "trusted_renderer_geometry_only_not_visual_content_evidence",
        "pathInference": "forbidden",
        "contactSheetSemantics": "overview_only_not_coverage_evidence",
        "visualVerification": {
          "slideCountSource": "inspect",
          "requestMode": "one_slide_per_render",
          "requestField": "pageOrSlide",
          "uniqueOutputPathPerSlide": true,
          "consumeEveryReturnedReadPath": true,
          "requiredVerdicts": "one_per_inspected_slide",
          "ledgerInvalidation": "any_deck_edit",
          "coverageCannotBeInferredFrom": [
            "total",
            "pageSelection",
            "layoutCoverage",
            "outputFilename",
            "contactSheet"
          ]
        }
      }
    },
    "script": {
      "builderTemplate": "templates/builder.mjs",
      "editorTemplate": "templates/editor.mjs",
      "editingReference": "references/editing-existing.md",
      "routes": {
        "create": "builder",
        "editExisting": "editor",
        "inspectValidateRender": "native",
        "nativeWrite": "forbidden"
      },
      "editTools": ["apply_patch", "write_file"],
      "executionTool": "run_command",
      "runtimeProfile": "presentations",
      "runtimeProfileBinding": "host_from_materialized_script_receipt",
      "outputArgument": "--output",
      "workspaceParents": {
        "mustExistBeforeUse": true,
        "appliesTo": ["materializationDestination", "managedOutput", "renderOutput"],
        "preparation": "createExactTaskOwnedParentsFirst",
        "hostPreflightBeforeScript": true,
        "hostPreflightBeforeRenderer": true
      },
      "editor": {
        "sourceArgument": "--source",
        "sourceArgumentCardinality": 1,
        "outputArgument": "--output",
        "outputArgumentCardinality": 1,
        "defaultPublishMode": "saveAs",
        "supportedPublishModes": ["saveAs"],
        "inPlace": false,
        "sourceBinding": "inputs.mountPath",
        "sourceRequired": true,
        "inspectBeforeEdit": true,
        "stableInspectedTargetsRequired": true,
        "positionShape": "taggedIndexAfterOrBefore",
        "structuralScope": "elementsAndOneTerminalWholeSlideMutation",
        "wholeSlideMutations": "editorAtMostOneAndLastThenReinspect",
        "targetRules": {
          "elementTarget": "inspectedIdRequired",
          "copyFrom": "inspectedIdRequired",
          "positionReference": "inspectedIdRequired",
          "wholeSlideTarget": "inspectedOneBasedSlideNumber",
          "parent": "slideContainerAllowed",
          "newParent": "slideContainerAllowed"
        },
        "externalImage": {
          "supportedOperation": "replaceImage",
          "target": "existingInspectedPictureRequired",
          "source": "inputMatchingDeclaredMountPath",
          "genericAddFileInput": false,
          "addNewImage": "unsupported",
          "setImageBackground": "unsupported",
          "unsupportedRecovery": "stopAndReport"
        },
        "boundedEditRegion": {
          "begin": "// BEGIN EDIT REGION",
          "end": "// END EDIT REGION"
        },
        "facade": {
          "specifier": "@mycopilot/presentation-sdk",
          "apiVersion": 1,
          "binding": "host",
          "providerArguments": "forbidden",
          "realPaths": "forbidden",
          "rawOoxml": "forbidden",
          "processLaunch": "forbidden",
          "network": "forbidden",
          "operations": [
            "editPresentation",
            "input",
          "output",
          "addSlide",
          "removeSlide",
          "moveSlide",
          "set",
            "replaceText",
            "add",
            "remove",
            "move",
            "swap",
            "replaceImage",
            "updateTableCell",
            "updateChart"
          ]
        },
        "transaction": {
          "source": "frozenReadOnly",
          "candidate": "hostPrivate",
          "targetSource": "nativeInspect",
          "targetValidation": "exactStableTargetOnFrozenSource",
          "planValidation": "host",
          "packageValidation": "requiredBeforePublish",
          "publication": "atomic",
          "failureBeforePublish": "sourceAndDestinationUnchanged"
        },
        "completion": {
          "inspectFinalSlideCount": true,
          "validate": true,
          "renderMode": "oneSlidePerRequest",
          "visualVerdicts": "onePerInspectedFinalSlide"
        }
      },
      "entrypoints": [
        {
          "command": "node",
          "extension": ".mjs",
          "runtimeVersion": "22.23.1",
          "dependencies": [{ "name": "pptxgenjs", "version": "4.0.1" }]
        },
        {
          "command": "python",
          "extension": ".py",
          "runtimeVersion": "3.12.13",
          "dependencies": [{ "name": "python-pptx", "version": "1.0.2" }]
        }
      ],
      "resolution": {
        "authority": "host",
        "runtimeKindFrom": "command",
        "dependencyPolicy": "profilePinned"
      },
      "inputs": {
        "field": "inputs",
        "mountPathField": "mountPath",
        "pathField": "path",
        "rootEnvironment": "MYCOPILOT_INPUT_ROOT",
        "pathKinds": [
          "workspace",
          "absolute_or_system",
          "attachment_read_path",
          "generated_artifact_uri",
          "revision_bound_skill_uri"
        ]
      },
      "observation": {
        "requiredFromModel": false,
        "binding": "host_from_materialization_and_output_argument",
        "kind": "office",
        "additionalRootsField": "observe.additionalRoots",
        "resultField": "artifactObservation"
      }
    }
  }
}
