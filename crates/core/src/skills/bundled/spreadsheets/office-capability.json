{
  "contractVersion": 10,
  "engine": "officecli",
  "tool": "office_spreadsheet",
  "extensions": [".xlsx"],
  "modes": {
    "native": {
      "tool": "office_spreadsheet",
      "bestFor": "authoritative_read_validate_render",
      "requestStyle": "flat_semantic_v1",
      "reasonField": "reason",
      "reasonRequired": true,
      "providerArguments": "host_generated",
      "operations": ["status", "inspect", "validate", "render"],
      "writeOperationsModelVisible": false,
      "modelVisibleWrites": "forbidden",
      "writeRoute": "managedScripts",
      "unsupportedRecovery": "useManagedScript",
      "renderOutput": {
        "resultField": "outputs",
        "role": "render",
        "kind": "image",
        "pathField": "readPath",
        "consumerTool": "read_image",
        "consumerField": "path",
        "readabilityField": "readableByAgent",
        "sizeField": "sizeBytes",
        "selectionField": "pageSelection",
        "selectionSemantics": "requested_not_verified_coverage",
        "pathInference": "forbidden"
      }
    },
    "script": {
      "builderTemplate": "templates/builder.py",
      "editorTemplate": "templates/editor.py",
      "editingReference": "references/editing-existing.md",
      "editTools": ["apply_patch", "write_file"],
      "executionTool": "run_command",
      "runtimeProfile": "spreadsheets",
      "runtimeProfileBinding": "host_from_materialized_script_receipt",
      "outputArgument": "--output",
      "sourceArgument": "--source",
      "routes": {
        "create": "builder",
        "editExisting": "editor",
        "inspectValidateRender": "native",
        "nativeWrite": "forbidden"
      },
      "pythonSemantics": {
        "execution": "normalPython",
        "astOrJsonDsl": "forbidden",
        "functions": true,
        "loops": true,
        "conditions": true,
        "comprehensions": true,
        "pinnedDependencyImports": true,
        "modelPatchRegion": "edit_workbook"
      },
      "transaction": {
        "scriptBytesFrozenBeforeExecution": true,
        "runtimeAndInputsFrozen": true,
        "sourceSnapshot": "hostReadOnlyInput",
        "candidateOutput": "hostPrivateStaging",
        "validation": "pinnedOfficeEngineBeforePublish",
        "targetPreconditionRechecked": true,
        "cancellationRechecked": true,
        "publish": "atomic",
        "failureBeforePublish": "hostCandidateNotPublishedToDeclaredDestination",
        "pythonSideEffectScope": "outsideOfficePublicationNotTransactional",
        "permissionBoundary": "existingRunCommandApprovalAndPermissions",
        "crossPlatformOsSandboxClaim": false
      },
      "lifecycle": {
        "prepareDirectoryBeforeMaterialize": true,
        "reuseSingleScript": true,
        "cleanupTaskOwnedFiles": true,
        "removeDirectoryOnlyIfTaskCreatedAndEmpty": true,
        "recursiveDelete": "forbidden"
      },
      "syntaxPreflight": {
        "binding": "hostAutomaticBeforeExecution",
        "language": "python",
        "modelCommand": "forbidden",
        "invalidatesOnScriptChange": true,
        "executionOnFailure": "forbidden"
      },
      "existingWorkbookEdit": {
        "sourceBinding": "inputs.mountPath",
        "loader": "openpyxl.load_workbook(data_only=false)",
        "implementation": "fixedNormalPythonEditor",
        "inspectBeforeEdit": true,
        "publishMode": "saveAsOnly",
        "rebuildToImitateEdit": "forbidden",
        "unsupportedFeaturePolicy": "failClosed"
      },
      "entrypoints": [
        {
          "command": "python",
          "extension": ".py",
          "runtimeVersion": "3.12.13",
          "dependencies": [
            { "name": "openpyxl", "version": "3.1.5" },
            { "name": "xlsxwriter", "version": "3.2.9" }
          ]
        }
      ],
      "resolution": {
        "authority": "host",
        "runtimeKindFrom": "command",
        "dependencyPolicy": "profilePinned"
      },
      "inputs": {
        "field": "inputs",
        "mountPathField": "mountPath",
        "pathField": "path",
        "rootEnvironment": "MYCOPILOT_INPUT_ROOT",
        "pathKinds": [
          "workspace",
          "absolute_or_system",
          "attachment_read_path",
          "generated_artifact_uri",
          "revision_bound_skill_uri"
        ]
      },
      "observation": {
        "requiredFromModel": false,
        "binding": "host_from_materialization_and_output_argument",
        "kind": "office",
        "additionalRootsField": "observe.additionalRoots",
        "resultField": "artifactObservation"
      }
    }
  },
  "calculation": {
    "authoringEngine": "openpyxl",
    "formulaWriteSemantics": "expressionStoredNotEvaluated",
    "recalculation": "notPerformed",
    "cachedValues": "notAuthoritative",
    "evidenceRequiredToClaimCalculated": "explicitAuthoritativeCalculationEngineResult",
    "claimWithoutEvidence": "forbidden"
  },
  "validation": {
    "inspectFinal": true,
    "sheetListSource": "nativeInspect",
    "usedRangeSource": "nativeInspect",
    "floatingObjectSource": "nativeInspectWhenReported",
    "packageValidation": "nativeValidate",
    "formulaText": "nativeInspectExactExpression",
    "calculationEvidence": "separateAuthoritativeEngineResult",
    "visual": {
      "coverage": "everyResolvableFinalSheetVisualExtent",
      "visualExtent": "populatedUsedRangeUnionReportedChartAndImageBounds",
      "requestMode": "oneResolvedVisualExtentPerFinalSheet",
      "consumeEveryReturnedReadPath": true,
      "requiredLedger": "oneVerdictOrExplicitIncompleteCoveragePerFinalSheet",
      "unresolvedFloatingObjectBounds": "discloseIncompleteCoverage",
      "pageSelectionSemantics": "requestedNotVerifiedCoverage"
    },
    "evidenceInvalidation": "anyFinalWorkbookEdit"
  }
}
