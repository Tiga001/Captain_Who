{
  "schemaVersion": 1,
  "id": "workflow-review",
  "name": "Develop and review",
  "description": "Implement then review; send findings back for revision.",
  "background": "Deliver a reviewed implementation.",
  "nodes": [
    {
      "id": "implement",
      "name": "implement",
      "templateId": null,
      "modelConfigId": null,
      "receives": "Receive the current task and previous result.",
      "task": "Complete the assigned step and report evidence.",
      "delivers": "Deliver the result to the selected outgoing flow.",
      "x": 280,
      "y": 180,
      "kind": "agent"
    },
    {
      "id": "review",
      "name": "review",
      "templateId": null,
      "modelConfigId": null,
      "receives": "Receive the current task and previous result.",
      "task": "Complete the assigned step and report evidence.",
      "delivers": "Deliver the result to the selected outgoing flow.",
      "x": 580,
      "y": 180,
      "kind": "agent"
    },
    {
      "id": "implement-input",
      "kind": "inputGate",
      "name": "Implementation input",
      "x": 40,
      "y": 180,
      "processingMode": "individual",
      "busyPolicy": "queue"
    },
    {
      "id": "review-output",
      "kind": "outputGate",
      "name": "Review output",
      "x": 860,
      "y": 180,
      "selection": {
        "mode": "one",
        "min": 1,
        "max": 1,
        "required": [],
        "groups": []
      }
    }
  ],
  "flows": [
    {
      "id": "entry",
      "name": "entry",
      "source": {
        "kind": "boundary"
      },
      "target": {
        "kind": "node",
        "nodeId": "implement-input"
      }
    },
    {
      "id": "submit",
      "name": "submit",
      "source": {
        "kind": "node",
        "nodeId": "implement"
      },
      "target": {
        "kind": "node",
        "nodeId": "review"
      }
    },
    {
      "id": "revise",
      "name": "revise",
      "source": {
        "kind": "node",
        "nodeId": "review-output"
      },
      "target": {
        "kind": "node",
        "nodeId": "implement-input"
      }
    },
    {
      "id": "deliver",
      "name": "deliver",
      "source": {
        "kind": "node",
        "nodeId": "review-output"
      },
      "target": {
        "kind": "boundary"
      }
    },
    {
      "id": "input-binding",
      "name": "",
      "source": {
        "kind": "node",
        "nodeId": "implement-input"
      },
      "target": {
        "kind": "node",
        "nodeId": "implement"
      }
    },
    {
      "id": "output-binding",
      "name": "",
      "source": {
        "kind": "node",
        "nodeId": "review"
      },
      "target": {
        "kind": "node",
        "nodeId": "review-output"
      }
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "boundaryPositions": {
    "input": {
      "x": -250,
      "y": 180
    },
    "output": {
      "x": 1120,
      "y": 180
    }
  }
